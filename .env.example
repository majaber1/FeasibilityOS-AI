# Saudi-Buisness V1 — copy to .env and replace all production secrets.
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_WEB_URL=http://localhost:3000

# SMTP account used for verification and password-reset links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
API_PORT=8000
WEB_PORT=3000

# Private Cloudflare R2 funding-document vault. Create an Object Read & Write
# token scoped only to this bucket; never make the bucket public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=saudi-business-funding-documents

# Optional when running services separately
# DATABASE_URL=postgresql://user:password@host:5432/saudi_business
# BACKEND_API_URL=http://localhost:8000
# Required by hosted Next.js deployments; never defaults to an external service.
# BACKEND_API_URL=https://api.your-domain.example
# CORS_ORIGINS=https://your-domain.example

# V2 AI Engine (Groq LLM)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
# GROQ_MODEL_FAST=llama-3.1-8b-instant

# Optional: Langfuse monitoring
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
